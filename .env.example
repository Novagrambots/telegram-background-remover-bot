# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# ==================== БАЗА ДАННЫХ ====================

# PostgreSQL (контейнер postgres из docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_remover
DB_USER=bot_user
DB_PASSWORD=changeme

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== ОГРАНИЧЕНИЯ ====================

# Максимальный размер входного файла (МБ)
MAX_INPUT_MB=20

# Максимальное разрешение (пиксели, по большей стороне)
MAX_RESOLUTION=4096

# ==================== МОДЕЛЬ REMBG ====================

# Модель по умолчанию: u2net | isnet-general-use
# u2net — универсальная, хороший баланс качество/скорость
# isnet-general-use — выше качество, чуть медленнее
DEFAULT_MODEL=u2net

# ==================== LOCAL BOT API (опционально) ====================

# Нужен если бот будет работать с файлами >50 МБ (через aiogram/telegram-bot-api)
# Получить API_ID и API_HASH на https://my.telegram.org
# BOT_API_URL=http://bot-api:8081
# API_ID=
# API_HASH=
